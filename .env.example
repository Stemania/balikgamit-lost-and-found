# Copy this file to `.env` and fill in your own values.
# On Render, set these under the service's "Environment" tab instead.

# MongoDB Atlas connection string (Connect -> Drivers -> Node.js), with your real password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0

# Local port (Render sets PORT automatically)
PORT=3000

# Optional, local only: use public DNS if you get "querySrv ECONNREFUSED"
# DNS_SERVERS=8.8.8.8,1.1.1.1
